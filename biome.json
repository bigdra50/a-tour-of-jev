{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "test/**", "*.json", "!bun.lock"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["src/web/lessons/code/**/*.js"],
      "javascript": {
        "globals": ["jev", "llm", "noul", "choice", "score", "print", "show", "mean", "stdev", "sleep", "settings"]
      },
      "linter": { "rules": { "correctness": { "noUndeclaredVariables": "error", "noUnusedVariables": "error" } } }
    }
  ]
}
