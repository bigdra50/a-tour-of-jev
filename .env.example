# このファイルを .env.local にコピーして値を入れる（.env.local は git 管理外）。
# シェルで export 済みの環境変数があれば、そちらも読み込む。

# TypeSafe の API キー（https://console.typesafe.ai/settings/keys）
TYPESAFE_API_KEY=

# Vercel AI Gateway の API キー（vck_ で始まる）
# vck_ で始まるキーは、どの変数名に入っていても Gateway 用として扱う。
AI_GATEWAY_API_KEY=

# 任意: 待ち受けポート（既定 8765）
# PORT=8765
