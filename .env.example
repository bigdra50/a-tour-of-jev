# Copy this file to .env.local and fill in the values (.env.local is not tracked by git).
# Variables exported in your shell are read too.
# このファイルを .env.local にコピーして値を入れる（.env.local は git 管理外）。
# シェルで export 済みの環境変数があれば、そちらも読み込む。

# TypeSafe API key / TypeSafe の API キー（https://console.typesafe.ai/settings/keys）
TYPESAFE_API_KEY=

# Vercel AI Gateway API key, starting with vck_ / Vercel AI Gateway の API キー（vck_ で始まる）
# A key that starts with vck_ is used for the Gateway, whatever variable it is in.
# vck_ で始まるキーは、どの変数名に入っていても Gateway 用として扱う。
AI_GATEWAY_API_KEY=

# Optional: port to listen on (default 8765) / 任意: 待ち受けポート（既定 8765）
# PORT=8765
