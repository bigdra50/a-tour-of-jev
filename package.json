{
  "name": "a-tour-of-jev",
  "version": "0.1.0",
  "private": true,
  "description": "Jev (TypeSafe System One) をブラウザで手を動かしながら学ぶローカル教材",
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file --hot src/server/main.ts",
    "start": "NODE_ENV=production bun --no-env-file src/server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@ai-sdk/provider": "4.0.17",
    "@ai-sdk/provider-utils": "5.0.45",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "ai": "7.0.107",
    "codemirror": "^6.0.2",
    "marked": "^18.0.13",
    "neverthrow": "^8.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
